{
  "name": "@productivity/mobile",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:dev": "APP_VARIANT=development expo run:ios --device \"iPhone 17\"",
    "prebuild:ios:dev": "APP_VARIANT=development expo prebuild -p ios --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@op-engineering/op-sqlite": "18.2.5",
    "@orpc/client": "catalog:",
    "@productivity/core": "workspace:*",
    "@react-native-community/datetimepicker": "9.2.1",
    "@sqlite-sync/core": "catalog:",
    "@sqlite-sync/react": "catalog:",
    "@sqlite-sync/react-native": "catalog:",
    "date-fns": "catalog:",
    "expo": "~58.0.9",
    "expo-constants": "~58.0.11",
    "expo-dev-client": "~58.0.13",
    "expo-font": "~58.0.8",
    "expo-linking": "~58.0.12",
    "expo-router": "~58.0.18",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.8",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.5",
    "kysely": "catalog:",
    "react": "catalog:",
    "react-native": "0.88.0-rc.4",
    "react-native-get-random-values": "^2.0.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.29.0",
    "tailwindcss": "catalog:",
    "uniwind": "^1.12.2"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "typescript": "catalog:"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "op-sqlite": {
    "sqliteFlags": "-DSQLITE_ENABLE_BYTECODE_VTAB=1"
  },
  "version": "1.0.0"
}
