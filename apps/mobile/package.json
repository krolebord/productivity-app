{
  "name": "@productivity/mobile",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:dev": "APP_VARIANT=development expo run:ios --device \"iPhone 17\"",
    "prebuild:ios:dev": "APP_VARIANT=development expo prebuild -p ios --clean",
    "typecheck": "tsc --noEmit",
    "update": "env -u APP_VARIANT -u EXPO_PUBLIC_API_URL eas update --channel production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.1.1",
    "@op-engineering/op-sqlite": "18.2.5",
    "@orpc/client": "catalog:",
    "@productivity/core": "workspace:*",
    "@react-native-community/datetimepicker": "9.2.1",
    "@sqlite-sync/core": "catalog:",
    "@sqlite-sync/react": "catalog:",
    "@sqlite-sync/react-native": "catalog:",
    "date-fns": "catalog:",
    "expo": "~58.0.23",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "expo-web-browser": "~58.0.7",
    "kysely": "catalog:",
    "react": "catalog:",
    "react-native": "0.88.1",
    "react-native-enriched-markdown": "1.1.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-skia": "2.15.1",
    "react-native-worklets": "0.13.0",
    "remend": "^1.4.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "catalog:",
    "uniwind": "^1.13.1",
    "victory-native": "^43.0.1"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "typescript": "catalog:"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "op-sqlite": {
    "sqliteFlags": "-DSQLITE_ENABLE_BYTECODE_VTAB=1"
  },
  "enriched-markdown": {
    "enableCodeHighlight": false,
    "enableMath": false,
    "enableVideo": false
  },
  "version": "1.0.0"
}
