{
  "expo": {
    "name": "Productivity",
    "slug": "productivity",
    "scheme": "productivity",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#8b5cf6",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/4481f5e3-4b42-43b5-81ae-858b60600034"
    },
    "experiments": {
      "reactCompiler": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#171717"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent",
          "defaultLaunchURL": "http://kirils-dev.tailc07dd9.ts.net:3303"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#171717"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lets you attach photos to assistant messages.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/android-theme",
      "./plugins/android-build-memory",
      "./plugins/rns-gamma"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4481f5e3-4b42-43b5-81ae-858b60600034"
      }
    },
    "owner": "krolebord"
  }
}
