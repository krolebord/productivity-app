{
  "expo": {
    "name": "Productivity",
    "slug": "productivity",
    "scheme": "productivity",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#8b5cf6",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/4481f5e3-4b42-43b5-81ae-858b60600034"
    },
    "experiments": {
      "reactCompiler": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#171717"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent",
          "defaultLaunchURL": "http://kirils-dev.tailc07dd9.ts.net:3303"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#171717"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lets you attach photos to assistant messages.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/android-theme",
      "./plugins/android-build-memory",
      "./plugins/rns-gamma",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "NotesWidget",
              "label": "Notes",
              "description": "Your notes in the Notes tab's order",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "TodayWidget",
              "label": "Today",
              "description": "Today's tasks and events",
              "minWidth": "280dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "FinancesWidget",
              "label": "Finances",
              "description": "Net worth and this month's spending",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal"
            }
          ]
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "NotesWidget",
              "displayName": "Notes",
              "description": "Your notes in the Notes tab's order.",
              "android": null,
              "ios": {
                "supportedFamilies": ["systemSmall", "systemLarge"],
                "initialLayout": "./src/widgets/ios-widgets.ios.tsx"
              }
            },
            {
              "name": "TodayWidget",
              "displayName": "Today",
              "description": "Today's tasks and events.",
              "android": null,
              "ios": {
                "supportedFamilies": ["systemLarge"],
                "initialLayout": "./src/widgets/ios-widgets.ios.tsx"
              }
            },
            {
              "name": "FinancesWidget",
              "displayName": "Finances",
              "description": "Net worth and this month's spending.",
              "android": null,
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"],
                "initialLayout": "./src/widgets/ios-widgets.ios.tsx"
              }
            }
          ]
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4481f5e3-4b42-43b5-81ae-858b60600034"
      }
    },
    "owner": "krolebord"
  }
}
