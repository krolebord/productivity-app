{
  // Project icon shown in the Agent UI sidebar.
  "iconPath": "apps/web/public/pwa-192x192.png",

  "commands": [
    {
      "id": "dev-server",
      "name": "Dev server",
      "run": "pnpm dev",
      "singleton": true
    },
    {
      "id": "dev-server-tailnet",
      "name": "Dev server (Tailnet)",
      // Runs on local 3302, exposed on access port 3301 — the port VITE_APP_URL
      // in .env points at, since magic links and the Google OAuth redirect only
      // resolve on that exact origin. The 30xx range belongs to other projects.
      // HMR rides the same port: Vite leaves the client's socket port unset, so
      // it reconnects over wss:// to whatever host/port served the page.
      "run": "ts-serve 3302:3301 && DEV_PORT=3302 DEV_ALLOWED_HOSTS=agent-ui-vps.tailc07dd9.ts.net pnpm dev",
      "singleton": true
    },
    {
      "id": "mobile-dev-client-tailnet",
      "name": "Mobile dev client (Tailnet)",
      // Metro serves plain HTTP straight on the tailnet hostname (no ts-serve: the dev
      // client can't load a bundle through the HTTPS proxy). The EAS development build
      // opens http://agent-ui-vps.tailc07dd9.ts.net:3303 on launch (defaultLaunchURL in
      // app.json). 8081 is left to another project's Metro.
      // The app talks to the "Dev server (Tailnet)" preset, so start that one too.
      "run": "APP_VARIANT=development REACT_NATIVE_PACKAGER_HOSTNAME=agent-ui-vps.tailc07dd9.ts.net EXPO_PUBLIC_API_URL=https://agent-ui-vps.tailc07dd9.ts.net:3301 pnpm dev:mobile -- --dev-client --lan --port 3303",
      "singleton": true
    },
    {
      "id": "mobile-ios-simulator",
      "name": "Mobile iOS simulator",
      // Local Xcode build of the dev variant, launched on the iPhone 17 simulator with
      // Metro. Run `pnpm prebuild:ios:dev` in apps/mobile first after app config changes.
      "run": "pnpm --filter @productivity/mobile run ios:dev",
      "singleton": true
    }
  ]
}
