{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "productivity",
  "main": "./src/server.ts",
  "account_id": "1f507c7933d231cc8051d23050bda6ab",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat", "enable_ctx_exports"],
  "route": {
    "pattern": "productivity.krolebord.com",
    "custom_domain": true
  },
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  "triggers": {
    "crons": ["17 * * * *"]
  },
  // Dev defaults. The `deploy` script overrides MODE=production and the prod
  // VITE_APP_URL via `wrangler deploy --var` so deployments run in production mode.
  "vars": {
    "MODE": "development",
    "VITE_APP_URL": "http://localhost:3001"
  },
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "d1_databases": [
    {
      "binding": "MAIN_DB",
      // Local label kept as productivity-db so local dev data is preserved.
      // Deploys bind by database_id (the prod productivity-prod database).
      "database_name": "productivity-db",
      "database_id": "da56fb48-d1ec-4584-aad5-86bd8785a6dc",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "UserDbServer",
        "name": "UserDbServer"
      },
      {
        "class_name": "AssistantAgent",
        "name": "AssistantAgent"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["UserDbServer"],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": ["AssistantAgent"],
      "tag": "v2"
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/rpc/*", "/api/*", "/user-db/*", "/agents/*"]
  }
}
