    "@sqlite-sync/ai": "^0.8.1",
    "@sqlite-sync/cloudflare": "^0.8.1",
    "@sqlite-sync/core": "^0.8.1",
    "@sqlite-sync/devtools": "^0.8.1",
    "@sqlite-sync/react": "^0.8.1",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/hotkeys": "^0.8.0",
