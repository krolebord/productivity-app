{
  "name": "productivity",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "VITE_APP_URL=https://productivity.krolebord.com npm run build && wrangler deploy --var MODE:production --var VITE_APP_URL:https://productivity.krolebord.com",
    "db:local:init": "wrangler d1 execute productivity-db --local --command \"SELECT 1;\"",
    "db:local:migrate": "wrangler d1 migrations apply productivity-db --local",
    "db:remote:migrate": "wrangler d1 migrations apply productivity-db --remote",
    "db:new-migration": "echo 'Enter migration name: ' && read MIGRATION_NAME && wrangler d1 migrations create productivity-db $MIGRATION_NAME",
    "docs:sync:sqlite-sync": "curl -fsSL https://raw.githubusercontent.com/krolebord-dev/sqlite-sync/refs/heads/main/docs.md -o docs/sqlite-sync.md",
    "generate:types:db": "DB_PATH=$(find ./.wrangler/state/v3/d1/miniflare-D1DatabaseObject -type f -name \"*.sqlite\" -print -quit) && kysely-codegen --dialect=sqlite --url=$DB_PATH --out-file=src/lib/db-types.ts --exclude-pattern=\"_cf_METADATA\"",
    "generate:types:env": "wrangler types",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "format": "biome check --write",
    "format:check": "biome check"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.210",
    "@cloudflare/ai-chat": "^0.8.6",
    "@cloudflare/shell": "0.4.0",
    "@cloudflare/think": "^0.10.0",
    "@cloudflare/vite-plugin": "^1.40.1",
    "@dnd-kit/core": "^6.3.1",
