    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@orpc/client": "^1.15.4",
    "@orpc/server": "^1.15.4",
    "@orpc/tanstack-query": "^1.15.4",
    "@posthog/ai": "^8.13.4",
    "@react-email/components": "^1.0.12",
    "@sqlite-sync/ai": "^0.10.1",
    "@sqlite-sync/cloudflare": "^0.10.1",
    "@sqlite-sync/core": "^0.10.1",
    "@sqlite-sync/devtools": "^0.10.1",
    "@sqlite-sync/react": "^0.10.1",
    "@tailwindcss/vite": "^4.3.3",
