{
  "name": "productivity",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "pnpm --filter @productivity/web run dev",
    "dev:mobile": "pnpm --filter @productivity/mobile run start",
    "update:mobile": "pnpm --filter @productivity/mobile run update",
    "build": "pnpm --filter @productivity/web run build",
    "preview": "pnpm --filter @productivity/web run preview",
    "deploy": "pnpm --filter @productivity/web run deploy",
    "db:local:init": "pnpm --filter @productivity/web run db:local:init",
    "db:local:migrate": "pnpm --filter @productivity/web run db:local:migrate",
    "db:remote:migrate": "pnpm --filter @productivity/web run db:remote:migrate",
    "db:new-migration": "pnpm --filter @productivity/web run db:new-migration",
    "e2e:code": "pnpm --filter @productivity/web run e2e:code",
    "docs:sync:sqlite-sync": "curl -fsSL https://raw.githubusercontent.com/krolebord-dev/sqlite-sync/refs/heads/main/docs.md -o docs/sqlite-sync.md",
    "generate:types:env": "pnpm --filter @productivity/web run generate:types:env",
    "sync:models": "pnpm --filter @productivity/core run sync:models",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "biome check --write",
    "format:check": "biome check",
    "doctor": "pnpm --filter @productivity/web run doctor"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  },
  "op-sqlite": {
    "sqliteFlags": "-DSQLITE_ENABLE_BYTECODE_VTAB=1"
  },
  "enriched-markdown": {
    "enableCodeHighlight": false,
    "enableMath": false,
    "enableVideo": false
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@mongodb-js/zstd",
      "@tailwindcss/oxide",
      "core-js-pure",
      "esbuild",
      "node-liblzma",
      "react-grab",
      "sharp",
      "workerd"
    ],
    "ignoredBuiltDependencies": [
      "react-native-enriched-markdown"
    ],
    "patchedDependencies": {
      "@cloudflare/think@0.16.0": "patches/@cloudflare__think@0.16.0.patch",
      "kysely-d1@0.4.0": "patches/kysely-d1@0.4.0.patch",
      "@op-engineering/op-sqlite@18.2.5": "patches/@op-engineering__op-sqlite@18.2.5.patch",
      "react-native-android-widget@0.26.0": "patches/react-native-android-widget@0.26.0.patch"
    }
  }
}
